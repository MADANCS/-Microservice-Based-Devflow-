{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://devflow-api-gateway-42ah.onrender.com/api/:path*"
    },
    {
      "source": "/ws/:path*",
      "destination": "https://devflow-api-gateway-42ah.onrender.com/ws/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
